@using System.Diagnostics
@using System.Text
@using HostsSpike.Client.Generated
@using HostsSpike.Client.Runtime
@inject IJSRuntime JS
@implements IAsyncDisposable

<pre id="results">@results</pre>

@code {
    // Runs the same generated-style code on whichever host renders it, and reports what it observed.
    string results = "running";
    IJsTransport? transport;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var sb = new StringBuilder();
        try
        {
            var browser = OperatingSystem.IsBrowser();
            transport = browser ? await JsImportTransport.CreateAsync() : await JsRuntimeTransport.CreateAsync(JS);
            sb.AppendLine($"transport: {transport.Name}");

            await using var view = await MapView.CreateAsync(transport, new() { Zoom = 4, Rotation = 0 });
            await view.SetZoomAsync(7);
            sb.AppendLine($"GetZoomAsync() after SetZoomAsync(7): {await view.GetZoomAsync()}");

            var pending = view.GetZoomAsync();
            sb.AppendLine($"GetZoomAsync() completed synchronously: {pending.IsCompletedSuccessfully}");
            await pending;

            double sum = 0;
            for (int i = 0; i < 50; i++) sum += await view.GetZoomAsync(); // warm-up
            int reads = browser ? 100_000 : 1_000;
            var sw = Stopwatch.StartNew();
            for (int i = 0; i < reads; i++) sum += await view.GetZoomAsync();
            sb.AppendLine($"await GetZoomAsync(), sequential:  {Per(sw, reads)}");

            if (browser) // on Server, continuations hop threads, so per-thread counters mean nothing
            {
                long allocated = GC.GetAllocatedBytesForCurrentThread();
                for (int i = 0; i < 1_000; i++) sum += await view.GetZoomAsync();
                allocated = GC.GetAllocatedBytesForCurrentThread() - allocated;
                sb.AppendLine($"managed bytes allocated per GetZoomAsync(): {allocated / 1_000.0:F0}");
            }

            int writes = browser ? 10_000 : 1_000;
            sw.Restart();
            for (int i = 0; i < writes; i++) await view.SetZoomAsync(i);
            sb.AppendLine($"await SetZoomAsync(), sequential:  {Per(sw, writes)}");

            sw.Restart();
            var inFlight = new Task[writes];
            for (int i = 0; i < writes; i++) inFlight[i] = view.SetZoomAsync(i).AsTask();
            await Task.WhenAll(inFlight);
            sb.AppendLine($"SetZoomAsync() pipelined (WhenAll): {Per(sw, writes)}");
            sb.AppendLine($"zoom after pipelined writes: {await view.GetZoomAsync()} (last write was {writes - 1}; order preserved)");

            sb.AppendLine($"snapshot: {await view.SnapshotAsync()}");

            var clicked = new TaskCompletionSource<ClickEvent>();
            await using (await view.OnClickAsync(e => clicked.TrySetResult(e)))
            {
                sw.Restart();
                await transport.RaiseAsync(view.Handle, "click", """{"x":10,"y":20}""");
                var e = await clicked.Task.WaitAsync(TimeSpan.FromSeconds(10));
                sb.AppendLine($"first event via {(browser ? "[JSExport]" : "DotNetObjectReference")}: {e} in {sw.Elapsed.TotalMilliseconds:F2} ms (cold path)");
            }
        }
        catch (Exception ex)
        {
            sb.AppendLine("ERROR " + ex);
        }
        results = sb.ToString();
        StateHasChanged();
    }

    static string Per(Stopwatch sw, int n)
    {
        var ns = sw.Elapsed.TotalMilliseconds * 1e6 / n;
        return ns >= 10_000 ? $"{ns / 1000:F1} µs/op" : $"{ns:F0} ns/op";
    }

    public async ValueTask DisposeAsync()
    {
        if (transport is IAsyncDisposable disposable) await disposable.DisposeAsync();
    }
}
