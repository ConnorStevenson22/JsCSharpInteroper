<Project Sdk="Microsoft.NET.Sdk">

  <!-- The compiler loads analyzers, so they target netstandard2.0. Shipped inside the Interoper.Runtime package
       (analyzers/dotnet/cs), not as a package of its own. Release tracking (RS2008): AnalyzerReleases.*.md, which
       Microsoft.CodeAnalysis.Analyzers picks up; a rule is listed under Unshipped until a release ships it. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

</Project>
