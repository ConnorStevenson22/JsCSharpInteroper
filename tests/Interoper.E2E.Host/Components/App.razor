<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <link rel="icon" href="data:," />
    <base href="/" />
    <ImportMap ImportMapDefinition="importMap" />
    <HeadOutlet />
</head>
<body>
    <Router AppAssembly="typeof(Interoper.E2E.Client.ContractSuite).Assembly">
        <Found Context="routeData"><RouteView RouteData="routeData" /></Found>
    </Router>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>
</html>

@code {
    // The app's assets plus the generated map of the fixture, served from /node_modules/ as a consumer would (design §3.5).
    ImportMapDefinition importMap => ImportMapDefinition.Combine(
        ImportMapDefinition.FromResourceCollection(Assets),
        new ImportMapDefinition(GoldenSlice.Async.DemoMaps.ImportMap("/node_modules"), null, null));
}
