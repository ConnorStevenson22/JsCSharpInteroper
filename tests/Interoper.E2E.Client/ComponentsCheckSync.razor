@using GoldenSlice.Sync
@inherits JsComponentBase

<DemoMap @ref="map" @bind-Zoom="zoom" Basemap="Basemap.Night" Center="center" OnDemoMapClick="Clicked" style="display:block">
    <Toolbar><button id="zoom-in" @onclick="() => zoom++">+</button></Toolbar>
    <ChildContent><span id="overlay">overlay</span></ChildContent>
</DemoMap>
<button id="read-view" @onclick="ReadView">read the view</button>
<pre id="state">zoom @zoom; clicks @string.Join(" ", clicks); view @view</pre>
<pre id="result" data-done="@done">@result</pre>

@code {
    // ComponentsCheck in sync mode (WebAssembly only): the component fetches its element through the async seam, and
    // sets Center through the sync one.
    DemoMap map = null!;
    double zoom = 3;
    readonly PointSnapshot center = new() { X = 2, Y = 3 };
    readonly List<string> clicks = [];
    string view = "", result = "";
    bool done;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            MapView? live = null;
            for (var i = 0; i < 200 && (live is null || live.Center != center); i++)
            {
                await Task.Delay(50);
                live = map.Element?.GetView(Scope);
            }
            result = $"PASS view zoom {live!.Zoom}, basemap {live.Basemap}, center {live.Center.X},{live.Center.Y}";
        }
        catch (Exception e)
        {
            result = $"FAIL {e.GetType().Name}: {e.Message}";
        }
        done = true;
        StateHasChanged();
    }

    void Clicked(DemoMapClickDetail detail) => clicks.Add($"{Math.Round(detail.X)},{Math.Round(detail.Y)}");

    void ReadView() => view = $"zoom {map.Element!.GetView(Scope).Zoom}";
}
