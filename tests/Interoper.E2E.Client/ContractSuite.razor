@using Interoper.Contract
@inject IJSRuntime JS

<pre id="result" data-done="@done">@string.Join("\n", lines)</pre>

@code {
    // Runs the transport contract (tests/Interoper.Runtime.Tests/TransportContract.cs) against fixtures/demo-maps
    // through one seam, and prints one line per case for the test to assert on.
    const string Load = """{"op":"load","modules":["@acme/demo-maps/MapView.js","@acme/demo-maps/Marker.js","@acme/demo-maps/measure.js"]}""";

    readonly List<string> lines = [];
    bool done;

    [Parameter, EditorRequired] public SeamKind Kind { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            if (Kind == SeamKind.TwoTransports)
            {
                await RunAsync("two transports on one page", async () =>
                    await TransportContract.Independent(await StartJsImportAsync(sync: true), await StartJsRuntimeAsync()));
                return;
            }
            var seam = await StartAsync();
            foreach (var (name, run) in TransportContract.Cases)
            {
                await RunAsync(name, () => run(seam));
            }
        }
        catch (Exception e)
        {
            lines.Add($"{e.GetType().Name}: {e.Message}");
        }
        finally
        {
            done = true;
            StateHasChanged();
        }
    }

    async Task RunAsync(string name, Func<Task> run)
    {
        try
        {
            await run();
            lines.Add($"PASS {name}");
        }
        catch (Exception e)
        {
            lines.Add($"FAIL {name}: {e.GetType().Name}: {e.Message}");
        }
    }

    Task<Seam> StartAsync() =>
        Kind == SeamKind.JsRuntime ? StartJsRuntimeAsync() : StartJsImportAsync(sync: Kind == SeamKind.JsImportSync);

    async Task<Seam> StartJsRuntimeAsync() => Seam.Async(await JsRuntimeTransport.StartAsync(JS, Fixture.Metadata), callbacksReturn: false);

    async Task<Seam> StartJsImportAsync(bool sync)
    {
        // On Server this fails fast: sync bindings need WebAssembly.
#pragma warning disable CA1416
        var transport = await JsImportTransport.StartAsync(Fixture.Metadata);
#pragma warning restore CA1416
        JsEnvelope.Check(await transport.InvokeAsync(Load)); // sync mode loads modules up front
        return sync ? Seam.Sync(transport) : Seam.Async(transport, callbacksReturn: true);
    }
}
