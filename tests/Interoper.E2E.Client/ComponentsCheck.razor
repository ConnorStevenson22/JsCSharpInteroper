@using GoldenSlice.Async
@inherits JsComponentBase

<DemoMap @ref="map" @bind-Zoom="zoom" Basemap="Basemap.Night" Center="center" OnDemoMapClick="Clicked" OnElementReady="ReadyAsync" id="map" style="display:block">
    <Toolbar><button id="zoom-in" @onclick="() => zoom++">+</button></Toolbar>
    <ChildContent><span id="overlay">overlay</span></ChildContent>
</DemoMap>
<demo-map id="raw" @ondemo-map-ready="() => rawReady = true"></demo-map>
<button id="read-view" @onclick="ReadViewAsync">read the view</button>
<pre id="state">zoom @zoom; clicks @string.Join(" ", clicks); view @view</pre>
<pre id="raw-state">raw ready @rawReady</pre>
<pre id="result" data-done="@done">@result</pre>

@code {
    // The async-mode component (R28) on its host, driven by tests/Interoper.E2E/ComponentTests: once its Element is
    // ready, Center was set after the first render; then the test clicks through the shadow surface, and binds Zoom
    // both ways. A hand-written element uses the generated [EventHandler]s (EventHandlers, in DemoMapsEvents.cs). ComponentsCheckSync is
    // the same in sync mode.
    DemoMap map = null!;
    double zoom = 3;
    readonly PointSnapshot center = new() { X = 2, Y = 3 };
    readonly List<string> clicks = [];
    string view = "", result = "";
    bool done, rawReady;

    async Task ReadyAsync(DemoMapElement element)
    {
        try
        {
            var live = await element.GetViewAsync(Scope);
            var c = await live.GetCenterAsync();
            result = $"PASS view zoom {await live.GetZoomAsync()}, basemap {await live.GetBasemapAsync()}, center {c.X},{c.Y}";
        }
        catch (Exception e)
        {
            result = $"FAIL {e.GetType().Name}: {e.Message}";
        }
        done = true;
    }

    void Clicked(DemoMapClickDetail detail) => clicks.Add($"{Math.Round(detail.X)},{Math.Round(detail.Y)}");

    async Task ReadViewAsync() => view = $"zoom {await (await map.Element!.GetViewAsync(Scope)).GetZoomAsync()}";
}
