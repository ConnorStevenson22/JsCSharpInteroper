{
  "schemaVersion": "2.1.0",
  "modules": [
    {
      "kind": "javascript-module",
      "path": "demo-map.js",
      "declarations": [
        {
          "kind": "class",
          "name": "DemoMapElement",
          "tagName": "demo-map",
          "customElement": true,
          "superclass": { "name": "HTMLElement", "package": "global:" },
          "description": "A map view as an element.",
          "attributes": [
            { "name": "basemap", "type": { "text": "Basemap" }, "fieldName": "basemap", "default": "\"streets\"" },
            { "name": "zoom", "type": { "text": "number" }, "fieldName": "zoom", "default": "1" }
          ],
          "members": [
            { "kind": "field", "name": "view", "type": { "text": "MapView" }, "readonly": true },
            { "kind": "field", "name": "basemap", "type": { "text": "Basemap" }, "attribute": "basemap" },
            { "kind": "field", "name": "zoom", "type": { "text": "number" }, "attribute": "zoom" },
            { "kind": "field", "name": "center", "type": { "text": "Point" } },
            {
              "kind": "method",
              "name": "clickAt",
              "parameters": [
                { "name": "x", "type": { "text": "number" } },
                { "name": "y", "type": { "text": "number" } },
                { "name": "button", "type": { "text": "0 | 1 | 2" }, "optional": true }
              ]
            }
          ],
          "events": [
            { "name": "demo-map-click", "type": { "text": "CustomEvent<DemoMapClickDetail>" } },
            { "name": "demo-map-zoom-change", "type": { "text": "CustomEvent<{ zoom: number }>" }, "description": "Fires when zoom changes; pairs with `zoom` for two-way binding." },
            { "name": "demo-map-ready", "type": { "text": "CustomEvent<null>" } }
          ],
          "slots": [
            { "name": "", "description": "Overlay content." },
            { "name": "toolbar", "description": "Controls above the map." }
          ],
          "cssParts": [
            { "name": "surface", "description": "The clickable map area." }
          ]
        }
      ],
      "exports": [
        { "kind": "js", "name": "DemoMapElement", "declaration": { "name": "DemoMapElement", "module": "demo-map.js" } },
        { "kind": "custom-element-definition", "name": "demo-map", "declaration": { "name": "DemoMapElement", "module": "demo-map.js" } }
      ]
    }
  ]
}
