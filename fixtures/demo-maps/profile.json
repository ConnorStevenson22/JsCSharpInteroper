{
  "package": "@acme/demo-maps",
  "runtimeClassProperty": "className",
  "valueClasses": ["Shape", "Point", "Line", "Polygon"],
  "events": {
    "mapProperty": "$events",
    "subscribe": "on"
  },
  "watch": "watch",
  "collections": ["Collection"],
  "include": [
    "Shape", "Point", "Line", "Polygon",
    "MapView.center", "MapView.zoom", "MapView.rotation", "MapView.basemap", "MapView.title", "MapView.selected",
    "MapView.flyTo", "MapView.on:click", "MapView.watch:zoom",
    "Marker.position", "Marker.label", "Marker.style", "Marker.displayLabel",
    "distance"
  ]
}
